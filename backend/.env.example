# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="AI-Powered College Information & Notice Assistant"
API_V1_STR="/api/v1"

# ==========================================
# Security & JWT Configuration
# Generate a secure key in production (e.g. openssl rand -hex 32)
# ==========================================
SECRET_KEY="college-assistant-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration
# Default: SQLite (no setup required, creates college_assistant.db locally)
# For PostgreSQL: postgresql://username:password@localhost:5432/college_assistant
# ==========================================
DATABASE_URL="sqlite:///./college_assistant.db"

# ==========================================
# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# File Storage Paths
# ==========================================
UPLOAD_DIR="./uploads"
VECTOR_STORE_DIR="./vector_store"
